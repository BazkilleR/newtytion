{
  "name": "fitness-log",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fitness/api --filter @fitness/web dev",
    "build": "pnpm --filter @fitness/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fitness/api db:generate",
    "db:migrate": "pnpm --filter @fitness/api db:migrate",
    "db:seed": "pnpm --filter @fitness/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
