# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness
TEST_DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_test

# API
PORT=3000
# Vite dev server port (BETTER_AUTH_URL must match it)
WEB_PORT=5173

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The browser only ever talks to Vite, so the public auth URL is the web origin.
BETTER_AUTH_URL=http://localhost:5173
