# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness
TEST_DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_test

# API
PORT=3000
# Vite dev server port
WEB_PORT=5173

# JWT signing secrets, one per token type. Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
